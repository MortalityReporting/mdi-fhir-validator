# Copy this file to `.env` and edit as needed. Settings here are loaded
# automatically at startup (see app/config.py) -- no image rebuild required
# to change them. For Docker deployments, pass the file at container-start
# time instead of baking it into the image, e.g.:
#   docker run --env-file .env ...
# or mount it directly:
#   docker run -v $(pwd)/.env:/app/.env:ro ...

# Path to the validator_cli.jar. The default (/opt/validator/validator_cli.jar)
# only exists inside the built Docker image -- set this explicitly for local/
# host runs (see AGENTS.md "Common pitfall").
# VALIDATOR_JAR_PATH=/opt/validator/validator_cli.jar

# Keep terminology-server session/cache state separate from other validator
# implementations. Use a different directory for each terminology endpoint.
# Set to "n/a" to disable terminology caching if supported by the CLI.
# TERMINOLOGY_CACHE_DIR=/root/.fhir/validator-service/terminology-cache
# Set true to clear stale terminology state on the next validator startup.
# CLEAR_TERMINOLOGY_CACHE_ON_STARTUP=false

# Automatically restart the child validator after a transport/protocol failure
# from $validate or $convert. The failed request is not replayed; requests
# arriving during restart receive a transient 503 response.
# AUTO_RECOVER_VALIDATOR=true
# Maximum restart attempts for one recovery event, with exponential backoff.
# VALIDATOR_RECOVERY_MAX_ATTEMPTS=3
# VALIDATOR_RECOVERY_BACKOFF_SECONDS=5
# VALIDATOR_RECOVERY_BACKOFF_MULTIPLIER=2
# Maximum time to drain in-flight validator HTTP calls before restarting.
# VALIDATOR_RECOVERY_OPERATION_DRAIN_TIMEOUT_SECONDS=10

# Packages advertised by GET /fhir/$packages, and ensured to be present in
# the FHIR package cache (~/.fhir/packages) and loaded into the running
# engine at startup. Comma-separated <packageId>#<version>.
#
# Each one is loaded via a 3-tier fallback chain, in order: 1) the FHIR
# package registry, 2) for draft/ci-build/screenshot-looking versions with
# a matching CI_BUILD_REPOS entry (below), a direct download from
# build.fhir.org, 3) the repo's local packages/ folder. See AGENTS.md
# "Configuring PACKAGES and DEFAULT_IG via .env" for details.
PACKAGES=hl7.fhir.us.vr-common-library#2.0.0,hl7.fhir.us.vdor#0.1.1-cibuild,hl7.fhir.us.mdi#3.0.0-draft,hl7.fhir.us.mdi#2.0.0,hl7.fhir.us.bser#2.0.0-ballot,hl7.fhir.us.vrdr#3.0.0,hl7.fhir.us.core#5.0.1

# The primary IG for this deployment. Loaded at startup like PACKAGES above;
# the validator automatically resolves and fetches *its* declared
# dependencies too (recursively), from the registry if not already cached.
# Leave empty/unset to disable.
DEFAULT_IG=hl7.fhir.us.core#5.0.1

# Path to a single FHIR resource (JSON or XML, by extension) validated once
# at startup against DEFAULT_IG, after it (and its dependencies) finish
# loading -- a warm-up/smoke test that surfaces IG/profile problems in the
# logs immediately rather than on the first real request. Relative paths
# resolve against the process's working directory. A missing file, or an
# empty DEFAULT_IG, is a no-op. Set VALIDATE_INITIAL_LOAD_RESOURCE_ON_STARTUP=false
# to disable outright.
# INITIAL_LOAD_RESOURCE_PATH=initial_load_resource.json
# VALIDATE_INITIAL_LOAD_RESOURCE_ON_STARTUP=true

# Periodically validate the initial-load resource to keep the terminology
# server cache/session active. The default is five minutes; set to 0 to disable.
# VALIDATOR_KEEPALIVE_INTERVAL_SECONDS=300

# Comma-separated <packageId>#<version>=<Org-or-User>/<Repo-Name> entries,
# used as tier 2 of the PACKAGES/DEFAULT_IG fallback chain above -- only
# consulted for versions that look like drafts/ci-builds/screenshots, and
# only for packages listed here (we don't guess a GitHub org/repo from a
# package id). Points at HL7's CI build server, e.g. the entry below
# resolves to https://build.fhir.org/ig/HL7/fhir-vdor/package.tgz.
CI_BUILD_REPOS=hl7.fhir.us.vdor#0.1.1-cibuild=HL7/fhir-vdor,hl7.fhir.us.mdi#3.0.0-draft=HL7/fhir-mdi-ig

# Comma-separated list of allowed CORS origins (e.g.
# "https://a.example.com,https://b.example.com"). Defaults to "*" (any
# origin) if unset. Also enables CORS preflight OPTIONS handling on every
# route.
# CORS_ALLOW_ORIGINS=*

# Optional path prefix prepended to the API docs URLs (/fhir/docs,
# /fhir/redoc, /fhir/openapi.json) -- useful when this service sits behind
# a reverse proxy under a non-root path (e.g. "/fhir-validator" makes the
# docs available at /fhir-validator/fhir/docs). Leave empty/unset to leave
# the docs URLs unprefixed.
# CUSTOM_PATH=

# Application log level. DEBUG is useful during local development; override
# this in production if a quieter log stream is preferred.
# LOG_LEVEL=DEBUG
